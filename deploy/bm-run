#!/bin/bash
# bm-run "Nome do job" comando [args...]
# Roda o comando (saída normal, para o log do cron) e informa o resultado ao vvy-backup.
# Se o vvy-backup estiver fora do ar, só avisa no log: o backup nunca depende dele.
# Credenciais em /root/.config/vvy-backup.env (BM_URL, BM_USER, BM_PASS).

name=$1; shift
out=$(mktemp)
start=$(date +%s)
"$@" 2>&1 | tee "$out"
code=${PIPESTATUS[0]}
end=$(date +%s)

msg=""
if [ "$code" -ne 0 ]; then
    msg="Saiu com código $code: $(tail -n 3 "$out" | sed 's/\x1b\[[0-9;]*m//g' | tr '\n' ' ')"
fi
rm -f "$out"

if . /root/.config/vvy-backup.env 2>/dev/null; then
    curl -sf -m 10 -o /dev/null -u "$BM_USER:$BM_PASS" "$BM_URL/api/report" \
        --data-urlencode "name=$name" -d "started=$start" -d "finished=$end" -d "code=$code" \
        --data-urlencode "msg=$msg" \
        || echo "bm-run: não foi possível avisar o vvy-backup ($BM_URL)" >&2
fi
exit "$code"
